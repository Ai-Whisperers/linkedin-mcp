# linkedin-mcp environment file.
# Generated from /opt/data/scripts/populate_social_secrets.py on 2026-08-25.
# To rotate, re-run populate_social_secrets.py linkedin and re-source this file.
#
# Each BWS secret was created in the "hermes" project. The populate script
# prints the UUID of every secret it creates — paste those UUIDs below.

# Static config
PYTHONPATH=/opt/data/integrations/linkedin-mcp
LINKEDIN_REDIRECT_URI=https://auth.hermes.paragu-ai.com/auth/linkedin/callback
LINKEDIN_API_VERSION=202608
LINKEDIN_API_BASE=https://api.linkedin.com
LINKEDIN_RATE_PER_HOUR=800
LINKEDIN_ENABLE_WRITES=true
LINKEDIN_LOG_LEVEL=INFO

# Required - filled by populate_social_secrets.py:
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_TOKEN_ISSUED_AT=
LINKEDIN_TOKEN_SCOPES=openid profile email w_member_social
LINKEDIN_REFRESH_TOKEN=

# Personal posting URN (urn:li:person:XXXX)
LINKEDIN_PERSON_URN=

# Org posting URN — only if Community Mgmt API approved (urn:li:organization:XXXX)
# LINKEDIN_ORG_URN=

# Set to "false" during App Review window (hides all write tools)
LINKEDIN_ENABLE_WRITES=true